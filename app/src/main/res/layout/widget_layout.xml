<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dip"
    android:orientation="vertical"
    android:resizeMode="horizontal"
    android:background="@color/common_signin_btn_light_text_default">

    <TextView
        android:id="@+id/txt"
        style="@android:style/TextAppearance.DeviceDefault.Widget.TextView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/widget_header"
        android:layout_margin="2dip">
    </TextView>

    <TextView
        android:id="@+id/widget_card_id"
        style="@android:style/TextAppearance.DeviceDefault.Widget.TextView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal|center_vertical"
        android:layout_margin="2dip">
    </TextView>
    
    <TextView
        android:id="@+id/widget_balance"
        style="@android:style/TextAppearance.DeviceDefault.Widget.TextView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal|center_vertical"
        android:layout_margin="2dip">
    </TextView>
    
       <TextView
        android:id="@+id/widget_lasttopupdate" style="@android:style/TextAppearance.DeviceDefault.Widget.TextView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal|center_vertical"
        android:layout_margin="2dip">
    </TextView>

    <TextView
        android:id="@+id/widget_latestupdate" style="@android:style/TextAppearance.DeviceDefault.Widget.TextView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal|center_vertical"
        android:layout_margin="4dip">
    </TextView>

</LinearLayout> 