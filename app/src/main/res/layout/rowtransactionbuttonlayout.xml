<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowtransactionbuttonlayout"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" >

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/tvRowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="date" >

        </TextView>

        <TextView
            android:id="@+id/tvRowDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="description" >

        </TextView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/tvRowAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:text="amount" >

        </TextView>

        <TextView
            android:id="@+id/tvRowEstimatedBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:text="estimated balance" >

        </TextView>
        <TextView
            android:id="@+id/tvRowBankSatementBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:text="bankstatementbalance" >

        </TextView>
    </LinearLayout>

    <Button
        android:id="@+id/delete_row_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete"

        android:layout_marginLeft="10px"
        android:layout_marginRight="10px" />
</LinearLayout>