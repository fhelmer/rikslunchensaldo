<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >
    <CheckBoxPreference
        android:key="auto_update"
        android:title="@string/auto_update"
        android:summary="@string/auto_update_summary"
        android:defaultValue="true" />

    <CheckBoxPreference
        android:key="show_notifications_update"
        android:title="@string/notifications"
        android:summary="@string/notifications_summary"
        android:defaultValue="true" />

    <EditTextPreference android:title="Start time for autoupdate (HH:MM)"
        android:key="start_time"
        android:inputMethod="TYPE_CLASS_DATETIME"
        android:summary="Please enter a time for recurring queries"/>


    <ListPreference     android:title="Update frequency"
        android:summary="Select rikslunchen update frequency (hours)"
        android:key="fetchInterval"
        android:defaultValue="1"
        android:entries="@array/fetchIntervalNames"
        android:entryValues="@array/fetchIntervalValues" />

</PreferenceScreen>