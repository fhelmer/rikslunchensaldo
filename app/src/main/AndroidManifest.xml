<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.helmer.rikslunchensaldo" >

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/lunch48"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >

        <activity android:name="se.helmer.rikslunchensaldo.MainActivity"
            android:label="@string/title_activity_main"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="se.helmer.rikslunchensaldo.SettingsActivity"
            android:label="@string/settings">
        </activity>


        <service android:exported="false" android:name=".MyIntentService"/>

        <receiver 
            android:name=".RikslunchenWidgetProvider"
            android:label="@string/largewidgetlabel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
        </receiver>

        <receiver android:name=".RikslunchenWidgetProviderSmall" android:label="@string/smallwidgetlabel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/small_widget_info"/>
        </receiver>

        <receiver android:name=".AlarmSetter" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".AlarmReceiver">
            <intent-filter>
                <action android:name="se.helmer.rikslunchensaldo.FETCH"/>
            </intent-filter>
        </receiver>

        <provider
            android:exported="false"
            android:name=".model.BankStatementContentProvider"
            android:authorities="se.helmer.rikslunchensaldo.bankstatementprovider" >
        </provider>

        <provider
            android:exported="false"
            android:name=".model.LogMessageContentProvider"
            android:authorities="se.helmer.rikslunchensaldo.logmessageprovider" >
        </provider>

        <provider
            android:exported="false"
            android:name=".model.EnterButtonContentProvider"
            android:authorities="se.helmer.rikslunchensaldo.enterbuttonprovider" >
        </provider>

        <activity android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
    </application>

</manifest>
